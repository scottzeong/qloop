# ─── 필수 환경변수 ───────────────────────────────────────────────────────────────

# JWT 세션 암호화 키 (랜덤 문자열 32자 이상 권장)
JWT_SECRET=your-very-long-random-secret-key-here

# TiDB Cloud (MySQL) 접속 URL
# TiDB Cloud 대시보드 → Connect → 비밀번호 포함 URL 복사
DATABASE_URL=mysql://user:password@gateway03.us-east-1.prod.aws.tidbcloud.com:4000/NvrzUNjEMAuyrZ6SHXrcZ8?ssl={"rejectUnauthorized":true}

# ─── OpenAI (문서 분석 AI) ────────────────────────────────────────────────────────

# OpenAI API 키 (platform.openai.com에서 발급)
OPENAI_API_KEY=sk-...

# ─── Cloudflare R2 (파일 저장소) ─────────────────────────────────────────────────

# Cloudflare 계정 ID (Cloudflare 대시보드 우측 상단)
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API 토큰에서 발급한 Access Key ID
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 API 토큰에서 발급한 Secret Access Key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# R2 버킷 이름
R2_BUCKET_NAME=qloop-storage

# ─── 서버 설정 ───────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
